# ============================================================
# LLMプロバイダー設定
# 使用するプロバイダーに応じてコメントアウトを切り替える
# ============================================================

# --- 使用するプロバイダーを選択 ---
# "bedrock" | "anthropic" | "openai" | "litellm" | "ollama"
LLM_PROVIDER=bedrock

# --- 共通 ---
LLM_MODEL_ID=claude-opus-4-5-20251001

# --- Amazon Bedrock ---
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1   # カスタムエンドポイントに変更可能

# --- LiteLLM (OpenAI互換エンドポイント) ---
# LLM_API_BASE=http://localhost:8000/v1       # 任意のOpenAI互換サーバー
# LLM_API_KEY=your-api-key

# --- Ollama (ローカル) ---
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3

# --- エージェント設定 ---
AGENT_SYSTEM_PROMPT="You are a helpful assistant. Answer concisely and clearly."

# ============================================================
# Langfuse トレーシング設定
# docker compose up -d でローカル起動後、
# http://localhost:3000 にアクセスしてアカウント作成 →
# Settings > API Keys でキーを発行して以下に設定する。
# ============================================================
LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key

# ============================================================
# 長期記憶 DB 設定（pgvector）
# docker compose up -d で postgres-memory コンテナが起動する
# ============================================================
MEMORY_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/agent_memory

# ============================================================
# ElevenLabs TTS 設定
# ============================================================
# TTS_ENABLED=false で音声読み上げを無効化できる（デフォルト: true）
TTS_ENABLED=true
ELEVENLABS_API_KEY=sk_...
# ボイスID（デフォルト: George / JBFqnCBsd6RMkjVDRZzb）
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# モデルID（デフォルト: eleven_v3 ← 最新モデル、日本語対応）
ELEVENLABS_MODEL_ID=eleven_v3
# 出力フォーマット
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
